server {
    listen 127.0.0.1:8443 ssl http2;
    server_name yhr.lol www.yhr.lol;
    ssl_certificate /etc/letsencrypt/live/yhr.lol/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/yhr.lol/privkey.pem;
    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 100m;
    # TLS is exposed on 443 through the stream proxy, not internal 8443.
    port_in_redirect off;

    # WorkBuddy OpenAI-compatible public API
    location ^~ /v1/ {
        proxy_pass http://127.0.0.1:7863;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        client_max_body_size 50m;
    }
    location = /v1 { return 301 /v1/; }

    # WorkBuddy console (relative paths, already scoped under /panel/)
    location = /panel { return 301 /panel/; }
    location ^~ /panel/ {
        proxy_pass http://127.0.0.1:7863;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 600s;
    }

    # ttyd web terminal (native --base-path /terminal)
    location ^~ /terminal/ {
        proxy_pass http://127.0.0.1:7681;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 86400;
    }

    # x-ui panel (native webBasePath /xui/)
    location = /xui { return 301 /xui/; }
    location ^~ /xui/ {
        proxy_pass https://127.0.0.1:18386;
        proxy_ssl_verify off;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 600s;
    }

    # x-ui subscription endpoint
    location ^~ /sub/ {
        proxy_pass https://127.0.0.1:2096;
        proxy_ssl_verify off;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # CloudCLI has no native base-path support; rewrite its absolute URLs.
    location = /cloudcli { return 301 /cloudcli/; }
    location ^~ /cloudcli/ {
        proxy_pass http://127.0.0.1:3001/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Accept-Encoding "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 600s;
        sub_filter_once off;
        sub_filter_types text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml;
        sub_filter 'href="/' 'href="/cloudcli/';
        sub_filter 'src="/' 'src="/cloudcli/';
        sub_filter 'url(/assets/' 'url(/cloudcli/assets/';
        sub_filter '"/api/' '"/cloudcli/api/';
        sub_filter '`/api/' '`/cloudcli/api/';
        sub_filter 'host}/ws' 'host}/cloudcli/ws';
        sub_filter 'host}/shell' 'host}/cloudcli/shell';
        sub_filter '"/sw.js"' '"/cloudcli/sw.js"';
        sub_filter "'/sw.js'" "'/cloudcli/sw.js'";
    }

    # Self-hosted LiveSync (CouchDB). CouchDB sets its own CORS headers,
    # so do not add any here and do not intercept OPTIONS.
    location = /livesync { return 301 /livesync/; }
    location ^~ /livesync/ {
        proxy_pass http://127.0.0.1:5984/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_request_buffering off;
        proxy_buffering off;
        client_max_body_size 4g;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    # Copytrade console
    location / {
        proxy_pass http://127.0.0.1:8766;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_buffering off;
    }
}
server { listen 80; server_name yhr.lol www.yhr.lol; return 301 https://$host$request_uri; }
